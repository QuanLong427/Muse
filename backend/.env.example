# Backend 私密配置模板（阿里云百炼 / Qwen）
# 复制此文件为 .env.local，将 WorkspaceId 和 API Key 替换为真实值。

OPENAI_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=your-dashscope-api-key-here
MODEL_NAME=qwen3.5-flash

# Agent 工具选择启用有限思考；Wiki JSON 抽取会始终关闭思考。
QWEN_AGENT_ENABLE_THINKING=true
QWEN_AGENT_THINKING_BUDGET=2048

# 语音输入/输出独立于 ReAct 主模型；TTS 目前要求北京业务空间域名。
VOICE_ASR_MODEL=qwen3-asr-flash
VOICE_TTS_MODEL=qwen-audio-3.0-tts-flash
VOICE_TTS_VOICE=longanhuan_v3.6

# 可选：Docker 中默认读取此路径。遇到 B 站 412 时，把 Netscape 格式
# cookies.txt 保存到项目 secrets/bilibili-cookies.txt；只读挂载会立即可见。
BILIBILI_COOKIES_FILE=/run/secrets/musicer/bilibili-cookies.txt
BILIBILI_DOWNLOAD_TIMEOUT_SECONDS=300
SQLITE_JOURNAL_MODE=DELETE

# web_search 复用以上 Qwen API Key 与 Base URL，并自动调用同地域的原生联网搜索端点。
